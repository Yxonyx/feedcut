<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Feedcut" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/c_primary</item>
        <item name="colorOnPrimary">@color/blaze_white</item>
        <item name="colorPrimaryContainer">@color/c_primary</item>
        <item name="colorOnPrimaryContainer">@color/blaze_white</item>
        <item name="colorSecondary">@color/c_bar</item>
        <item name="colorOnSecondary">@color/blaze_white</item>
        <item name="android:colorBackground">@color/c_bg</item>
        <item name="colorSurface">@color/c_bg</item>
        <item name="colorOnSurface">@color/c_ink</item>
        <item name="colorOnSurfaceVariant">@color/c_muted</item>
        <item name="colorSurfaceContainerHighest">@color/c_line</item>
        <item name="colorSurfaceContainerHigh">@color/c_surface</item>
        <item name="colorOutline">@color/c_muted</item>
        <item name="colorOutlineVariant">@color/c_line</item>
        <item name="android:windowBackground">@color/c_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">always</item>
        <item name="materialButtonStyle">@style/Widget.Feedcut.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Feedcut.Button.Outlined</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Feedcut.Dialog</item>
    </style>

    <!-- Dialogs are cut boards too, and their buttons use the label face. -->
    <style name="ThemeOverlay.Feedcut.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceCornerExtraLarge">@style/Shape.Feedcut.Blaze</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Feedcut.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Feedcut.DialogButton</item>
    </style>

    <!-- Ink, not red: red text on the dialog surface is under 4.5:1 in the dark scheme. -->
    <style name="Widget.Feedcut.DialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAppearance">@style/TextAppearance.Feedcut.ButtonLabel</item>
        <item name="android:textColor">@color/c_ink</item>
        <item name="shapeAppearance">@style/Shape.Feedcut.Blaze</item>
    </style>

    <!-- Back or Home: one segment painted in ink, the other bare. -->
    <style name="Widget.Feedcut.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.Feedcut.ButtonLabel</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:textColor">@color/toggle_text</item>
        <item name="backgroundTint">@color/toggle_bg</item>
        <item name="strokeColor">@color/c_muted</item>
        <item name="shapeAppearance">@style/Shape.Feedcut.Blaze</item>
    </style>

    <style name="Widget.Feedcut.Field" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">3dp</item>
        <item name="boxCornerRadiusTopEnd">3dp</item>
        <item name="boxCornerRadiusBottomStart">3dp</item>
        <item name="boxCornerRadiusBottomEnd">3dp</item>
        <item name="boxStrokeColor">@color/field_stroke</item>
        <item name="hintTextColor">@color/c_ink</item>
        <item name="android:textColorHint">@color/c_muted</item>
        <item name="cursorColor">@color/c_ink</item>
    </style>

    <style name="Widget.Feedcut.Button" parent="Widget.Material3.Button">
        <item name="android:textAppearance">@style/TextAppearance.Feedcut.ButtonLabel</item>
        <item name="shapeAppearance">@style/Shape.Feedcut.Blaze</item>
    </style>

    <style name="Widget.Feedcut.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.Feedcut.ButtonLabel</item>
        <item name="android:textColor">@color/c_ink</item>
        <item name="strokeColor">@color/c_muted</item>
        <item name="shapeAppearance">@style/Shape.Feedcut.Blaze</item>
    </style>

    <!-- Trail signs are cut boards, not pills. -->
    <style name="Shape.Feedcut.Blaze" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">3dp</item>
    </style>

    <style name="TextAppearance.Feedcut.ButtonLabel" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/barlow</item>
        <item name="fontFamily">@font/barlow</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="TextAppearance.Feedcut.Wordmark" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/barlow</item>
        <item name="fontFamily">@font/barlow</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/c_ink</item>
    </style>

    <style name="TextAppearance.Feedcut.Status" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/barlow</item>
        <item name="fontFamily">@font/barlow</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">21sp</item>
        <item name="android:textColor">@color/c_ink</item>
    </style>

    <style name="TextAppearance.Feedcut.Count" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/barlow_condensed_extrabold</item>
        <item name="fontFamily">@font/barlow_condensed_extrabold</item>
        <item name="android:textSize">112sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/c_ink</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="TextAppearance.Feedcut.CountLabel" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/barlow</item>
        <item name="fontFamily">@font/barlow</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textColor">@color/c_ink</item>
    </style>

    <style name="TextAppearance.Feedcut.Section" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/barlow</item>
        <item name="fontFamily">@font/barlow</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/c_muted</item>
    </style>

    <style name="TextAppearance.Feedcut.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/c_ink</item>
    </style>

    <style name="TextAppearance.Feedcut.Small" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/c_muted</item>
    </style>
</resources>
