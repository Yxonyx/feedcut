<?xml version="1.0" encoding="utf-8"?>
<!-- An unpainted waymark: the blaze's bands drawn, no paint. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape><stroke android:width="1.5dp" android:color="@color/c_muted" /><corners android:radius="2dp" /></shape>
    </item>
    <item android:top="6dp" android:height="1.5dp" android:gravity="top|fill_horizontal">
        <shape><solid android:color="@color/c_muted" /></shape>
    </item>
    <item android:bottom="6dp" android:height="1.5dp" android:gravity="bottom|fill_horizontal">
        <shape><solid android:color="@color/c_muted" /></shape>
    </item>
</layer-list>
