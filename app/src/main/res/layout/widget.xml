<?xml version="1.0" encoding="utf-8"?>
<!-- The main screen's sign at home screen size. The launcher cannot load Barlow Condensed,
     so FeedcutWidget paints the signage into images and the tint here gives them their colour.
     android:tint stays: the launcher inflates this without AppCompat, so app:tint would do nothing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_board"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp"
    tools:ignore="ContentDescription,UseAppTint,UseCompoundDrawables">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="@color/c_ink" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/widget_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:tint="@color/c_ink" />

            <TextView
                android:id="@+id/widget_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/c_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="14dp"
            android:layout_height="20dp"
            android:layout_gravity="top"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/waymark_done" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/widget_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:max="1000"
        android:progressDrawable="@drawable/widget_bar" />

    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:visibility="gone">

            <TextView
                android:id="@+id/widget_name_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/c_ink"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/widget_left_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:tint="@color/c_ink" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/c_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/widget_name_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/c_ink"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/widget_left_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:tint="@color/c_ink" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/widget_space"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_cuts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/c_muted"
        android:textSize="14sp" />
</LinearLayout>
