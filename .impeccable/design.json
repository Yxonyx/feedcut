  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The single filled button on a screen: the next step to take.",
      "html": "<button class=\"ds-btn-primary\">Accessibility</button>",
      "css": ".ds-btn-primary{background:#B81F18;color:#F4F2EC;border:none;border-radius:3px;height:40px;padding:0 24px;min-width:240px;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:16px;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;transition:filter .15s}.ds-btn-primary:hover{filter:brightness(1.08)}.ds-btn-primary:active{filter:brightness(.92)}.ds-btn-primary:focus-visible{outline:2px solid #17191A;outline-offset:2px}@media (prefers-color-scheme: dark){.ds-btn-primary{background:#D7261E}.ds-btn-primary:focus-visible{outline-color:#F4F2EC}}"
    },
    {
      "name": "Outlined Button",
      "kind": "button",
      "refersTo": "button-outlined",
      "description": "Every other action: secondary setup actions, Rules file, Restore default rules.",
      "html": "<button class=\"ds-btn-outlined\">App settings</button>",
      "css": ".ds-btn-outlined{background:transparent;color:#17191A;border:1px solid #55574F;border-radius:3px;height:40px;padding:0 24px;min-width:240px;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:16px;letter-spacing:.04em;text-transform:uppercase;cursor:pointer;transition:background .15s}.ds-btn-outlined:hover{background:rgba(23,25,26,.06)}.ds-btn-outlined:focus-visible{outline:2px solid #17191A;outline-offset:2px}@media (prefers-color-scheme: dark){.ds-btn-outlined{color:#F4F2EC;border-color:#A3A59F}.ds-btn-outlined:hover{background:rgba(244,242,236,.08)}.ds-btn-outlined:focus-visible{outline-color:#F4F2EC}}"
    },
    {
      "name": "Status Blaze",
      "kind": "custom",
      "refersTo": "status-blaze",
      "description": "The signature status: ON whole, OFF unpainted, STUCK snapped in trail yellow, always with the status sentence.",
      "html": "<div class=\"ds-blaze-set\"><div><svg class=\"ds-blaze\" viewBox=\"0 0 300 40\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><rect x=\"0.75\" y=\"0.75\" width=\"298.5\" height=\"38.5\" rx=\"3\" fill=\"#F4F2EC\"/><rect x=\"0\" y=\"12\" width=\"300\" height=\"16\" fill=\"#D7261E\"/><rect x=\"0.75\" y=\"0.75\" width=\"298.5\" height=\"38.5\" rx=\"3\" fill=\"none\" stroke=\"#55574F\" stroke-width=\"1.5\"/></svg><p class=\"ds-status\">On. Cutting 4 feeds.</p></div><div><svg class=\"ds-blaze\" viewBox=\"0 0 300 40\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><rect x=\"0.75\" y=\"0.75\" width=\"298.5\" height=\"38.5\" rx=\"3\" fill=\"none\" stroke=\"#55574F\" stroke-width=\"1.5\"/><line x1=\"0.75\" y1=\"12\" x2=\"299.25\" y2=\"12\" stroke=\"#55574F\" stroke-width=\"1.5\"/><line x1=\"0.75\" y1=\"28\" x2=\"299.25\" y2=\"28\" stroke=\"#55574F\" stroke-width=\"1.5\"/></svg><p class=\"ds-status\">Off. The feeds are open.</p></div><div><svg class=\"ds-blaze\" viewBox=\"0 0 300 40\" preserveAspectRatio=\"none\" aria-hidden=\"true\"><rect x=\"0\" y=\"0\" width=\"141\" height=\"40\" rx=\"3\" fill=\"#F4F2EC\"/><rect x=\"0\" y=\"12\" width=\"141\" height=\"16\" fill=\"#F2B84B\"/><rect x=\"0.75\" y=\"0.75\" width=\"139.5\" height=\"38.5\" rx=\"3\" fill=\"none\" stroke=\"#55574F\" stroke-width=\"1.5\"/><rect x=\"159\" y=\"5.6\" width=\"141\" height=\"34.4\" rx=\"3\" fill=\"#F4F2EC\"/><rect x=\"159\" y=\"15.9\" width=\"141\" height=\"13.8\" fill=\"#F2B84B\"/><rect x=\"159.75\" y=\"6.35\" width=\"139.5\" height=\"32.9\" rx=\"3\" fill=\"none\" stroke=\"#55574F\" stroke-width=\"1.5\"/></svg><p class=\"ds-status\">Switched on, but Android stopped it. Turn it off and on.</p></div></div>",
      "css": ".ds-blaze-set{display:grid;gap:20px;max-width:360px}.ds-blaze{display:block;width:100%;height:40px}.ds-status{margin:12px 0 0;font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:21px;color:#17191A}@media (prefers-color-scheme: dark){.ds-status{color:#F4F2EC}}"
    },
    {
      "name": "Today Count",
      "kind": "custom",
      "refersTo": "status-line",
      "description": "The one oversized element: condensed numerals beside the count labels and the estimate note.",
      "html": "<div class=\"ds-count\"><span class=\"ds-count-n\">42</span><div><div class=\"ds-count-l\">feeds cut today</div><div class=\"ds-count-l\">≈ 42 min kept</div><div class=\"ds-count-note\">Estimate: 1 min per cut.</div></div></div>",
      "css": ".ds-count{display:flex;align-items:flex-end;gap:16px;color:#17191A}.ds-count-n{font-family:'Barlow Condensed',sans-serif;font-weight:800;font-size:112px;letter-spacing:-.02em;line-height:.78}.ds-count-l{font-family:'Barlow Condensed',sans-serif;font-weight:700;font-size:22px}.ds-count-note{margin-top:4px;font-family:Roboto,sans-serif;font-size:14px;line-height:20px;color:#55574F}@media (prefers-color-scheme: dark){.ds-count{color:#F4F2EC}.ds-count-note{color:#A3A59F}}"
    },
    {
      "name": "Week View",
      "kind": "custom",
      "refersTo": "week-row",
      "description": "Seven rows on a fixed 120-minute scale: moss for past days, red for today, a stub for zero.",
      "html": "<div class=\"ds-week\"><div class=\"ds-wk\"><span>Thu</span><i style=\"width:25%\"></i><b>30 min</b></div><div class=\"ds-wk\"><span>Fri</span><i class=\"ds-zero\"></i><b>0 min</b></div><div class=\"ds-wk\"><span>Sat</span><i style=\"width:100%\"></i><b>134 min+</b></div><div class=\"ds-wk ds-today\"><span>Sun</span><i style=\"width:35%\"></i><b>42 min</b></div></div>",
      "css": ".ds-week{max-width:360px;font-family:'Barlow Condensed',sans-serif;font-weight:600;font-size:15px;color:#55574F}.ds-wk{display:grid;grid-template-columns:44px 1fr 64px;align-items:center;height:26px}.ds-wk i{display:block;height:8px;background:#4B6B45;margin-right:8px}.ds-wk i.ds-zero{width:3px;height:2px;background:#CFCCC2}.ds-wk b{font-weight:600;text-align:right}.ds-today{color:#17191A}.ds-today i{background:#B81F18}@media (prefers-color-scheme: dark){.ds-week{color:#A3A59F}.ds-wk i{background:#5E7F57}.ds-wk i.ds-zero{background:#303332}.ds-today{color:#F4F2EC}.ds-today i{background:#D7261E}}"
    },
    {
      "name": "App Row",
      "kind": "card",
      "refersTo": "app-row",
      "description": "Hairline-ruled row: app name, fixed-furniture detail line, standard switch; ochre detail when a rule may be broken.",
      "html": "<div class=\"ds-rows\"><label class=\"ds-row\"><span><span class=\"ds-row-name\">Instagram</span><span class=\"ds-row-detail\">Reels · last cut 4 min ago</span></span><input class=\"ds-switch\" type=\"checkbox\" checked aria-label=\"Instagram\"></label><label class=\"ds-row\"><span><span class=\"ds-row-name\">YouTube</span><span class=\"ds-row-detail ds-warn\">Shorts · Updated since the last cut. The rule may be broken.</span></span><input class=\"ds-switch\" type=\"checkbox\" checked aria-label=\"YouTube\"></label><div class=\"ds-row\"><span><span class=\"ds-row-name ds-muted\">TikTok</span><span class=\"ds-row-detail\">The video feed · Not installed</span></span></div></div>",
      "css": ".ds-rows{max-width:360px;border-bottom:1px solid #CFCCC2}.ds-row{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:68px;padding:10px 0;border-top:1px solid #CFCCC2;box-sizing:border-box}.ds-row-name{display:block;font-family:Roboto,sans-serif;font-size:16px;line-height:24px;color:#17191A}.ds-row-detail{display:block;margin-top:2px;font-family:Roboto,sans-serif;font-size:14px;line-height:20px;color:#55574F}.ds-muted{color:#55574F}.ds-warn{color:#7A4E00}.ds-switch{appearance:none;width:52px;height:32px;border-radius:16px;background:#CFCCC2;border:2px solid #55574F;position:relative;flex:none;cursor:pointer;transition:background .15s}.ds-switch::after{content:'';position:absolute;top:6px;left:6px;width:16px;height:16px;border-radius:50%;background:#55574F;transition:all .15s}.ds-switch:checked{background:#B81F18;border-color:#B81F18}.ds-switch:checked::after{left:22px;top:2px;width:24px;height:24px;background:#F4F2EC}.ds-switch:focus-visible{outline:2px solid #17191A;outline-offset:2px}@media (prefers-color-scheme: dark){.ds-rows,.ds-row{border-color:#303332}.ds-row-name{color:#F4F2EC}.ds-row-detail,.ds-muted{color:#A3A59F}.ds-warn{color:#F2B84B}.ds-switch{background:#303332;border-color:#A3A59F}.ds-switch::after{background:#A3A59F}.ds-switch:checked{background:#D7261E;border-color:#D7261E}.ds-switch:checked::after{background:#F4F2EC}}"
    },
    {
      "name": "Setup Waymark Step",
      "kind": "custom",
      "refersTo": "waymark",
      "description": "Setup as a trail: painted waymark when done, unpainted outline when to do.",
      "html": "<div class=\"ds-steps\"><div class=\"ds-step\"><svg class=\"ds-mark\" viewBox=\"0 0 14 20\" aria-hidden=\"true\"><rect x=\"0.75\" y=\"0.75\" width=\"12.5\" height=\"18.5\" rx=\"2\" fill=\"none\" stroke=\"#55574F\" stroke-width=\"1.5\"/><rect x=\"0\" y=\"6\" width=\"14\" height=\"1.5\" fill=\"#55574F\"/><rect x=\"0\" y=\"12.5\" width=\"14\" height=\"1.5\" fill=\"#55574F\"/></svg><div><div class=\"ds-step-t\">Turn Feedcut on in Accessibility</div><div class=\"ds-step-d\">Greyed out? Open App settings, tap the three dots, then Allow restricted settings.</div></div></div><div class=\"ds-step\"><svg class=\"ds-mark\" viewBox=\"0 0 14 20\" aria-hidden=\"true\"><rect x=\"0.5\" y=\"0.5\" width=\"13\" height=\"19\" rx=\"2\" fill=\"#F4F2EC\" stroke=\"#55574F\"/><rect x=\"1\" y=\"6\" width=\"12\" height=\"8\" fill=\"#D7261E\"/></svg><div><div class=\"ds-step-t\">Battery: Unrestricted</div></div></div></div>",
      "css": ".ds-steps{max-width:360px}.ds-step{display:flex;padding-top:14px}.ds-mark{flex:none;width:14px;height:20px;margin:2px 14px 0 0}.ds-step-t{font-family:Roboto,sans-serif;font-size:16px;line-height:24px;color:#17191A}.ds-step-d{margin-top:2px;font-family:Roboto,sans-serif;font-size:14px;line-height:20px;color:#55574F}@media (prefers-color-scheme: dark){.ds-step-t{color:#F4F2EC}.ds-step-d{color:#A3A59F}}"
    },
    {
      "name": "Section Heading and Advanced Row",
